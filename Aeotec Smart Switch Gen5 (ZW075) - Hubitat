/* -------------------------------------------------------------------------- */
/* Lifecycle                                                                  */
/* -------------------------------------------------------------------------- */

def installed() {
    logDebug("installed()")
    initialize()
}

def updated() {
    logDebug("updated()")
    unschedule()
    return configure()
}

def initialize() {
    logDebug("initialize()")
    return refresh()
}

/* -------------------------------------------------------------------------- */
/* Commands                                                                   */
/* -------------------------------------------------------------------------- */

def on() {
    logDebug("on()")
    return cmdSequence([
        zwave.switchBinaryV1.switchBinarySet(switchValue: 0xFF),
        zwave.switchBinaryV1.switchBinaryGet()
    ], 250)
}

def off() {
    logDebug("off()")
    return cmdSequence([
        zwave.switchBinaryV1.switchBinarySet(switchValue: 0x00),
        zwave.switchBinaryV1.switchBinaryGet()
    ], 250)
}

def poll() {
    return refresh()
}

def refresh() {
    logDebug("refresh()")
    return cmdSequence([
        zwave.switchBinaryV1.switchBinaryGet(),
        zwave.meterV3.meterGet(scale: 0), // kWh
        zwave.meterV3.meterGet(scale: 2), // Watts
        zwave.meterV3.meterGet(scale: 4), // Volts
        zwave.meterV3.meterGet(scale: 5)  // Amps
    ], 250)
}

def resetEnergy() {
    logDebug("resetEnergy()")
    return cmdSequence([
        zwave.meterV3.meterReset(),
        zwave.meterV3.meterGet(scale: 0)
    ], 250)
}
/**
 * Manually read all configuration parameters managed by this driver.
 * Results from this manual check are logged at INFO even when Debug is off.
 */
def checkParameters() {
    log.info "${device.displayName} Checking configuration parameters..."

    // Configuration Reports received during this window are from the
    // deliberate manual parameter check and are therefore logged at INFO.
    state.parameterCheckUntil = now() + 30000

    return cmdSequence(parameterNumbers().collect {
        zwave.configurationV1.configurationGet(parameterNumber: it)
    }, 350)
}

/**
 * Read the device manufacturer, product type and product ID without changing
 * any device configuration.  The response is logged at INFO so this command
 * can be used with Debug logging disabled.
 */
def checkDeviceInfo() {
    log.info "${device.displayName} Checking device information..."

    state.deviceInfoCheckUntil = now() + 30000

    return cmdSequence([
        zwave.manufacturerSpecificV2.manufacturerSpecificGet(),
        zwave.versionV2.versionGet()
    ], 500)
}

/* -------------------------------------------------------------------------- */
/* Configuration                                                              */
/* -------------------------------------------------------------------------- */

def configure() {
    Integer p90 = boolValue(param90, true) ? 1 : 0
    Integer p91 = (param91 != null ? param91.toInteger() : 25)
    Integer p92 = (param92 != null ? param92.toInteger() : 5)

    Integer group1 = buildReportGroup(param101_voltage, param101_current, param101_watts, param101_kwh)

    Integer p112Ui = (param112 != null ? param112.toInteger() : 0)
    boolean group2Disabled = (p112Ui == 0)
    Integer group2 = group2Disabled ? 0 : buildReportGroup(param102_voltage, param102_current, param102_watts, param102_kwh)
    Integer p112 = group2Disabled ? DISABLED_REPORT_INTERVAL : p112Ui

    Integer p113Ui = (param113 != null ? param113.toInteger() : 0)
    boolean group3Disabled = (p113Ui == 0)
    Integer group3 = group3Disabled ? 0 : buildReportGroup(param103_voltage, param103_current, param103_watts, param103_kwh)
    Integer p113 = group3Disabled ? DISABLED_REPORT_INTERVAL : p113Ui

    Integer p111 = (param111 != null ? param111.toInteger() : 300)
    Integer p3 = (param3 != null ? param3.toInteger() : 0)
    Integer p20 = (param20 != null ? param20.toInteger() : 0)
    Integer p80 = (param80 != null ? param80.toInteger() : 0)
    Integer p81 = (param81 != null ? param81.toInteger() : 0)

    logDebug("configure() P3=${p3}, P20=${p20}, P80=${p80}, P81=${p81}")
    logDebug("configure() P90=${p90}, P91=${p91}, P92=${p92}")
    logDebug("configure() P101=${group1}, P111=${p111}")
    logDebug("configure() P102=${group2}, P112=${p112}${group2Disabled ? ' (Disabled)' : ''}")
    logDebug("configure() P103=${group3}, P113=${p113}${group3Disabled ? ' (Disabled)' : ''}")

    List cmds = []

    // Ensure the hub is in Lifeline association Group 1.
    cmds << zwave.associationV2.associationSet(groupingIdentifier: 1, nodeId: zwaveHubNodeId)
    cmds << zwave.associationV2.associationGet(groupingIdentifier: 1)

    // SET followed by GET for verification.
    addConfigSetGet(cmds, 3,   1, p3)
    addConfigSetGet(cmds, 20,  1, p20)
    addConfigSetGet(cmds, 80,  1, p80)
    addConfigSetGet(cmds, 81,  1, p81)

    addConfigSetGet(cmds, 90,  1, p90)
    addConfigSetGet(cmds, 91,  2, p91)
    addConfigSetGet(cmds, 92,  1, p92)

    addConfigSetGet(cmds, 101, 4, group1)
    addConfigSetGet(cmds, 111, 4, p111)
    addConfigSetGet(cmds, 102, 4, group2)
    addConfigSetGet(cmds, 112, 4, p112)
    addConfigSetGet(cmds, 103, 4, group3)
    addConfigSetGet(cmds, 113, 4, p113)

    return cmdSequence(cmds, 500)
}

private void addConfigSetGet(List cmds, Integer parameter, Integer size, Integer value) {
    cmds << zwave.configurationV1.configurationSet(
        parameterNumber: parameter,
        size: size,
        scaledConfigurationValue: value
    )
    cmds << zwave.configurationV1.configurationGet(parameterNumber: parameter)
}

private List<Integer> parameterNumbers() {
    return [3, 20, 80, 81, 90, 91, 92, 101, 111, 102, 112, 103, 113]
}

private Integer buildReportGroup(def voltage, def current, def watts, def kwh) {
    Integer mask = 0
    if (boolValue(voltage, false)) mask += 1
    if (boolValue(current, false)) mask += 2
    if (boolValue(watts, false))   mask += 4
    if (boolValue(kwh, false))     mask += 8
    return mask
}

private boolean boolValue(def value, boolean defaultValue = false) {
    if (value == null) return defaultValue
    return value.toString().toBoolean()
}

private Map reportIntervalOptions(boolean includeDisabled) {
    Map options = [:]
    if (includeDisabled) options[0] = "Disabled"
    options[3] = "3 Seconds"
    options[5] = "5 Seconds"
    options[10] = "10 Seconds"
    options[15] = "15 Seconds"
    options[30] = "30 Seconds"
    options[60] = "1 Minute"
    options[120] = "2 Minutes"
    options[300] = "5 Minutes"
    options[600] = "10 Minutes"
    options[900] = "15 Minutes"
    options[1800] = "30 Minutes"
    options[3600] = "1 Hour"
    options[7200] = "2 Hours"
    options[10800] = "3 Hours"
    options[21600] = "6 Hours"
    options[43200] = "12 Hours"
    options[86400] = "24 Hours"
    return options
}

/* -------------------------------------------------------------------------- */
/* Parse / Z-Wave Events                                                      */
/* -------------------------------------------------------------------------- */

def parse(String description) {
    logDebug("parse: ${description}")

    def cmd = zwave.parse(description, commandClassVersions())
    if (!cmd) {
        log.warn "${device.displayName} Unable to parse: ${description}"
        return []
    }

    logDebug("parsed: ${cmd}")
    return zwaveEvent(cmd)
}

def zwaveEvent(hubitat.zwave.commands.securityv1.SecurityMessageEncapsulation cmd) {
    def encapsulated = cmd.encapsulatedCommand(commandClassVersions())
    if (encapsulated) {
        return zwaveEvent(encapsulated)
    }
    log.warn "${device.displayName} Unable to extract secure command: ${cmd}"
    return []
}

def zwaveEvent(hubitat.zwave.commands.crc16encapv1.Crc16Encap cmd) {
    def encapsulated = zwave.getCommand(cmd.commandClass, cmd.command, cmd.data)
    if (encapsulated) {
        return zwaveEvent(encapsulated)
    }
    log.warn "${device.displayName} Unable to extract CRC16 command: ${cmd}"
    return []
}

def zwaveEvent(hubitat.zwave.commands.switchbinaryv1.SwitchBinaryReport cmd) {
    return switchEvent(cmd.value)
}

def zwaveEvent(hubitat.zwave.commands.switchbinaryv1.SwitchBinarySet cmd) {
    return switchEvent(cmd.switchValue)
}

def zwaveEvent(hubitat.zwave.commands.basicv1.BasicReport cmd) {
    return switchEvent(cmd.value)
}

def zwaveEvent(hubitat.zwave.commands.basicv1.BasicSet cmd) {
    return switchEvent(cmd.value)
}

private def switchEvent(def rawValue) {
    String value = rawValue ? "on" : "off"
    String text = "${device.displayName} was turned ${value}"
    if (device.currentValue("switch") != value && txtEnable) log.info text
    return createEvent(name: "switch", value: value, descriptionText: text)
}

def zwaveEvent(hubitat.zwave.commands.meterv3.MeterReport cmd) {
    if (cmd.meterType != 1) return []

    Map evt
    switch (cmd.scale) {
        case 0:
            evt = [name: "energy", value: cmd.scaledMeterValue, unit: "kWh"]
            break
        case 2:
            evt = [name: "power", value: Math.round(cmd.scaledMeterValue), unit: "W"]
            break
        case 4:
            evt = [name: "voltage", value: cmd.scaledMeterValue, unit: "V"]
            break
        case 5:
            evt = [name: "amperage", value: cmd.scaledMeterValue, unit: "A"]
            break
        default:
            logDebug("Unhandled MeterReport scale ${cmd.scale}: ${cmd}")
            return []
    }

    String text = meterDescription(evt)
    evt.descriptionText = text

    if (device.currentValue(evt.name)?.toString() != evt.value?.toString() && txtEnable) {
        log.info text
    }

    return createEvent(evt)
}
private String meterDescription(Map evt) {
    switch (evt.name) {
        case "power":
            return "${device.displayName} Electric power is ${evt.value} ${evt.unit}"
        case "energy":
            return "${device.displayName} Electric energy is ${evt.value} ${evt.unit}"
        case "voltage":
            return "${device.displayName} Electric voltage is ${evt.value} ${evt.unit}"
        case "amperage":
            return "${device.displayName} Electric amperage is ${evt.value} ${evt.unit}"
        default:
            return "${device.displayName} ${evt.name} is ${evt.value} ${evt.unit ?: ''}".trim()
    }
}

def zwaveEvent(hubitat.zwave.commands.configurationv1.ConfigurationReport cmd) {
    return handleConfigurationReport(cmd)
}

def zwaveEvent(hubitat.zwave.commands.configurationv2.ConfigurationReport cmd) {
    return handleConfigurationReport(cmd)
}

private def handleConfigurationReport(cmd) {
    String msg = "Configuration Parameter ${cmd.parameterNumber} = ${cmd.scaledConfigurationValue} " +
                 "(size ${cmd.size}, raw ${cmd.configurationValue})"

    if ((state.parameterCheckUntil ?: 0) > now()) {
        log.info "${device.displayName} ${msg}"
    } else {
        logDebug(msg)
    }

    return []
}

def zwaveEvent(hubitat.zwave.commands.associationv2.AssociationReport cmd) {
    logDebug("Association Group ${cmd.groupingIdentifier}: nodes=${cmd.nodeId}, maxNodes=${cmd.maxNodesSupported}, reportsToFollow=${cmd.reportsToFollow}")
    return []
}

def zwaveEvent(hubitat.zwave.commands.versionv2.VersionReport cmd) {
    String fw = "${cmd.applicationVersion}.${String.format('%02d', cmd.applicationSubVersion)}"
    String msg = "Firmware ${fw}; Z-Wave protocol ${cmd.zWaveProtocolVersion}.${cmd.zWaveProtocolSubVersion}"

    updateDataValue("firmware", fw)

    if ((state.deviceInfoCheckUntil ?: 0) > now()) {
        log.info "${device.displayName} ${msg}"
    } else {
        logDebug(msg)
    }

    return []
}

def zwaveEvent(hubitat.zwave.commands.manufacturerspecificv2.ManufacturerSpecificReport cmd) {
    String msr = String.format("%04X-%04X-%04X", cmd.manufacturerId, cmd.productTypeId, cmd.productId)
    String modelText = identifyAeotecModel(cmd.manufacturerId, cmd.productTypeId, cmd.productId)
    String msg = "Manufacturer ID=${String.format('%04X', cmd.manufacturerId)}, " +
                 "Product Type=${String.format('%04X', cmd.productTypeId)}, " +
                 "Product ID=${String.format('%04X', cmd.productId)}, MSR=${msr}" +
                 (modelText ? ", Model=${modelText}" : "")

    updateDataValue("MSR", msr)
    if (cmd.manufacturerName) updateDataValue("manufacturer", cmd.manufacturerName)

    if ((state.deviceInfoCheckUntil ?: 0) > now()) {
        log.info "${device.displayName} ${msg}"
    } else {
        logDebug("Manufacturer report: ${msg}")
    }

    return []
}

private String identifyAeotecModel(Integer manufacturerId, Integer productTypeId, Integer productId) {
    if (manufacturerId != 0x0086) return null

    if (productId == 0x004B) {
        return "Aeotec Smart Switch Gen5 (ZW075)"
    }

    if (productId == 0x0060) {
        return "Aeotec Smart Switch 6 (ZW096)"
    }

    return "Aeotec device (unrecognized product ID by this driver)"
}

def zwaveEvent(hubitat.zwave.Command cmd) {
    logDebug("Unhandled command: ${cmd}")
    return []
}

/* -------------------------------------------------------------------------- */
/* Z-Wave Helpers                                                             */
/* -------------------------------------------------------------------------- */

private String cmd(hubitat.zwave.Command command) {
    if (getDataValue("zwaveSecurePairingComplete") == "true" && getDataValue("S2") == null) {
        return zwave.securityV1.securityMessageEncapsulation().encapsulate(command).format()
    }
    if (getDataValue("zwaveSecurePairingComplete") == "true") {
        return zwaveSecureEncap(command)
    }
    return command.format()
}

private def cmdSequence(Collection commands, Integer delayMs = 250) {
    return delayBetween(commands.collect { cmd(it) }, delayMs)
}

private Map commandClassVersions() {
    return [
        0x20: 1, // Basic
        0x25: 1, // Switch Binary
        0x27: 1, // Switch All
        0x2B: 1, // Scene Activation
        0x2C: 1, // Scene Actuator Configuration
        0x32: 3, // Meter
        0x56: 1, // CRC16 Encapsulation
        0x59: 1, // Association Group Info
        0x5A: 1, // Device Reset Locally
        0x5E: 2, // Z-Wave Plus Info
        0x70: 1, // Configuration
        0x72: 2, // Manufacturer Specific
        0x73: 1, // Powerlevel
        0x7A: 2, // Firmware Update MD
        0x82: 1, // Hail
        0x85: 2, // Association
        0x86: 2, // Version
        0x98: 1  // Security S0
    ]
}

private void logDebug(String msg) {
    if (logEnable) log.debug "${device.displayName} ${msg}"
}
