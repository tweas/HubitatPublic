/**************************************************************************************************
 *
 *  State Variables
 *
 **************************************************************************************************/

def initializeState() {

    state.loopCounter = 0

    state.refreshCounter = calculateRefreshCounter()
    
   if(state.grillStatus == null)
        state.grillStatus = []

   if(state.foodStatus == null)
        state.foodStatus = []


}
/**************************************************************************************************
 *
 *  Trigger Switch Handler
 *
 **************************************************************************************************/

def triggerHandler(evt) {

    if(enableDebug)
        log.debug "Trigger Switch = ${evt.value}"

    if(evt.value == "on") {

        startMonitoring()

    }
    else {

        stopMonitoring()

    }

}

/**************************************************************************************************
 *
 * Calculate Flip Handler
 *
 **************************************************************************************************/

def calculateFlipHandler(evt) {

    logInfo "Calculate Flip requested"

    if(triggerSwitch.currentValue("switch") != "on") {

        logWarn "Cannot calculate flip. Monitoring is not active."

        if(calculateFlipSwitch) {
            calculateFlipSwitch.off()
        }

        return

    }


    recalculateFlip()
	monitorTemperatures()

    calculateFlipSwitch.off()

}

/**************************************************************************************************
 *
 * Clear Alerts Handler
 *
 * Clears alert history without stopping monitoring.
 *
 **************************************************************************************************/

def clearAlertsHandler(evt) {

    logInfo "Clear Alerts requested"


    if(triggerSwitch.currentValue("switch") != "on") {

        logWarn "Cannot clear alerts. Monitoring is not active."

        clearAlertsSwitch.off()

        return

    }


    clearAlertStates()


    if(clearAlertsSwitch) {
        clearAlertsSwitch.off()
    }

}

/**************************************************************************************************
 *
 * Clear Alert States
 *
 * User requested a new alert cycle.
 * Resets alert flags without stopping FireBoard polling.
 *
 **************************************************************************************************/

def clearAlertStates() {

    logInfo "Clearing alert states"


    /*
     * Reset Grill Alerts
     */

    state.grillStatus = (state.grillStatus ?: []).collect { grill ->

        grill.targetAlertSent = false
        grill.lowAlertSent = false
        grill.highAlertSent = false
        grill.targetReached = false

        return grill

    }


    /*
     * Reset Food Alerts
     */

    state.foodStatus = (state.foodStatus ?: []).collect { food ->

        food.flipAlertSent = false
        food.doneAlertSent = false
        food.done = false

        return food

    }


    logDebug "Alert states cleared"


}

/**************************************************************************************************
 *
 * Recalculate Food Flip Temperature
 *
 * Uses current temperature as the new cook starting point.
 *
 **************************************************************************************************/

def recalculateFlip(boolean useCurrentTemperature = true) {
     if(!state.foodStatus) {

            logWarn "No food sensors initialized. Cannot calculate flip."

            return

      }

    state.foodStatus = state.foodStatus.collect { food ->


        def sensor = foodSensors.find {
            it.displayName == food.sensor
        }


        if(sensor) {


            BigDecimal startTemp


            if(useCurrentTemperature) {

                startTemp = sensor.currentTemperature as BigDecimal
                food.cookStartTemp = startTemp
                food.currentTemp = startTemp

            }
            else {

                startTemp = food.cookStartTemp as BigDecimal

            }


            food.flipTemp = Math.round(
                startTemp +
                ((food.targetTemp - startTemp) / 2)
            )

            food.lastCalculatedFlip = food.flipTemp
            
            // Update Hub Variable if assigned
            if(useHubVariables && foodFlipVariable) {

                setHubVariableValue(
                    foodFlipVariable,
                    food.flipTemp.toInteger()
                )

            }

            food.flipAlertSent = false


            logInfo """
Flip recalculated:

Sensor:
${food.sensor}

Start Temperature:
${startTemp}

Target:
${food.targetTemp}

New Flip Temperature:
${food.flipTemp}
"""

        }


        return food

    }

}

/**************************************************************************************************
 *
 *  Start Monitoring
 *
 **************************************************************************************************/

def startMonitoring() {

    log.info "Starting FireBoard Monitor"


    if(!validateHubVariables()) {

        log.error "Hub Variable validation failed."

        stopMonitoring()

        return

    }


    verifyFireBoardSettings()

    initializeState()

 	logDebug "Selected Grill Sensor: ${grillSensors?.displayName}"
    logDebug "Selected Food Sensors: ${foodSensors*.displayName}"
    if(!validateSensorAssignments()) {

    log.warn "Invalid sensor assignment. Monitoring stopped."

    stopMonitoring()

    return

	}
    
    logDebug "Grill Target: ${getGrillTarget()}"
	logDebug "Grill Low: ${getGrillLow()}"
	logDebug "Grill High: ${getGrillHigh()}"

	logDebug "Food Target: ${getFoodTarget()}"
	logDebug "Food Flip: ${getFoodFlip()}"
    
  		// fireboardDevice.on()
  		// FireBoard driver scheduling disabled.
 		 // App is controlling polling directly.
	logDebug "FireBoard driver scheduler disabled. App polling active."

	initializeCook()
    
    runIn(
        startupDelay,
        startPolling,
        [
            overwrite:true
        ]
    )

}

/**************************************************************************************************
 *
 * Initialize Cook
 *
 * Captures starting temperatures and initializes alert states.
 *
 **************************************************************************************************/

def initializeCook() {

    logDebug "Initializing cook state"


    state.grillStatus = []

    state.foodStatus = []


    /*
     * Initialize Grill Sensors
     */

    if(grillSensors) {

        grillSensors.each { sensor ->

            def grill = [

                sensor: sensor.displayName,

                currentTemp: sensor.currentTemperature,

                targetTemp: getGrillTarget(),

                lowAlert: getGrillLow(),

                highAlert: getGrillHigh(),

                targetAlertSent: false,
                
                targetReached: false,

                lowAlertSent: false,

                highAlertSent: false

            ]


            state.grillStatus << grill


            logDebug """
Initialized Grill:

Sensor: ${grill.sensor}
Starting Temp: ${grill.currentTemp}
Target: ${grill.targetTemp}
Low Alert: ${grill.lowAlert}
High Alert: ${grill.highAlert}
"""

        }

    }


    /*
     * Initialize Food Sensors
     */

    if(foodSensors) {

        foodSensors.each { sensor ->


            BigDecimal startTemp = sensor.currentTemperature as BigDecimal


            BigDecimal flipTemp = getFoodFlip()

            /*
             * Only calculate if there is no existing flip value.
             */

            if(flipTemp == null) {

                flipTemp =
                    (
                        startTemp +
                        ((getFoodTarget() - startTemp) / 2)
                    ).setScale(
                        0,
                        BigDecimal.ROUND_HALF_UP
                    )

                if(useHubVariables && foodFlipVariable) {

                    setHubVariableValue(
                        foodFlipVariable,
                        flipTemp
                    )

                }

            }


            def food = [
                sensor: sensor.displayName,
                cookStartTemp: startTemp,
                currentTemp: startTemp,
                targetTemp: getFoodTarget(),
                flipTemp: flipTemp,
                lastCalculatedFlip: flipTemp,
                done: false,
                flipAlertSent: false,
                doneAlertSent: false
            ]


            state.foodStatus << food


            logDebug """
Initialized Food:

Sensor: ${food.sensor}
Starting Temp: ${food.cookStartTemp}
Target: ${food.targetTemp}
Flip Temp: ${food.flipTemp}
"""

        }

    }


}

/**************************************************************************************************
 *
 *  Polling Engine
 *
 *  The FireBoard driver is configured for Manual refresh.
 *  This app controls:
 *
 *      GetTemperature()
 *      refresh()
 *
 **************************************************************************************************/

def startPolling() {

    logInfo "Starting FireBoard polling engine"

    state.loopCounter = 0
    state.refreshCounter = calculateRefreshCounter()

    if(!validateApiLimits()) {

        log.warn "Polling configuration exceeds FireBoard API limits. Polling stopped."
        stopMonitoring()
        return

    }

    logDebug "Performing initial FireBoard refresh"

    fireboardDevice.refresh()
    
    monitorTemperatures()
    
    state.loopCounter = 0

    runIn(
        pollSeconds.toInteger(),
        "pollLoop",
        [
            overwrite:true
        ]
    )

}


/**************************************************************************************************
 *
 *  Main Poll Loop
 *
 **************************************************************************************************/

def pollLoop() {


    // Make sure monitoring switch is still enabled

    if(triggerSwitch.currentValue("switch") != "on") {

        logDebug "Trigger switch is off. Stopping polling."
        log.debug "Trigger Switch = ${triggerSwitch.currentValue("switch")}" // added to see what the state of the switch is.
        stopMonitoring()
        return

    }


    if(state.loopCounter == null) {
        state.loopCounter = 0
    }


    state.loopCounter++


    if(state.loopCounter >= state.refreshCounter) {


        logDebug "Running full FireBoard refresh"

        /*
         * FireBoard driver refresh performs:
         *
         * GetTemperature()
         * ListAllDevices()
         *
         * Drive logging is disabled.
         */

        fireboardDevice.refresh()
        
        state.loopCounter = 0


    }
    else {


        logDebug "Running FireBoard temperature update"

        fireboardDevice.GetTemperature()


    }

    monitorTemperatures()

    /*
     * Schedule next poll.
     *
     * overwrite:true prevents multiple polling loops
     * if the hub becomes delayed or the switch is toggled.
     */

    runIn(
        pollSeconds.toInteger(),
        "pollLoop",
        [
            overwrite:true
        ]
    )


}


/**************************************************************************************************
 *
 * Calculate how many temperature polls occur before a full refresh.
 *
 * Example:
 *
 * Poll every 20 seconds
 * Refresh every 5 minutes
 *
 * (5 * 60) / 20 = 15 polls
 *
 **************************************************************************************************/

def calculateRefreshCounter() {


    Integer pollTime = pollSeconds.toInteger()

    Integer refreshTime = refreshMinutes.toInteger() * 60
    
    Integer count = Math.floor(
        refreshTime / pollTime
    )


    if(count < 1) {

        count = 1

    }


    logDebug "Refresh counter calculated as ${count}"


    return count

}

/**************************************************************************************************
 *
 * API Limit Validation
 *
 * Maximum:
 *
 * 17 calls per rolling 5 minutes
 *
 * GetTemperature = 1 call
 * refresh = 2 calls
 * refresh + Drive Logging = 3 calls
 **************************************************************************************************/

def validateApiLimits() {


    Integer pollTime = pollSeconds.toInteger()

    Integer refreshTime = refreshMinutes.toInteger()


    /*
     * Determine refresh API cost
     */

    Integer refreshCost = 2

    def driveLogging = fireboardDevice.getSetting("HasDrive")
    def refreshSetting = fireboardDevice.getSetting("RefreshRate")
    
    logDebug "FireBoard Settings: RefreshRate=${refreshSetting}, HasDrive=${driveLogging}"
    
    String driveStatus = 
    (driveLogging == true || driveLogging == null) ? "Enabled" : "Disabled"

    if(driveLogging == true || driveLogging == null) {

        refreshCost = 3

    }


    /*
     * Calls in a rolling 5 minute window
     */

    if(pollTime < 5) {

        log.warn "Polling interval too short."

        return false

    }

    Double temperatureCalls =
        300.0 / pollTime


    Double refreshes =
        5.0 / refreshTime



    /*
     * A refresh already includes GetTemperature().
     *
     * Our loop does:
     *
     * Normal cycles:
     *      GetTemperature()
     *
     * Refresh cycle:
     *      refresh()
     *
     * Therefore:
     *
     * Number of normal temperature calls
     * plus refresh calls.
     */

    Double totalCalls =
        temperatureCalls +
        (refreshes * (refreshCost - 1))



    logDebug """
    FireBoard API Calculation:

    Temperature Poll:
    ${pollTime} seconds

    Full Refresh:
    Every ${refreshTime} minutes

    Drive Logging:
    ${driveStatus}

    Refresh API Cost:
    ${refreshCost}

    Temperature Poll Calls:
    ${temperatureCalls}

    Refresh Additional Calls:
    ${(refreshes * (refreshCost - 1))}

    Total Calls / 5 Minutes:
    ${totalCalls.round(2)}
    """



    if(totalCalls > 17) {


        state.apiWarning =
        """
        Polling settings exceed FireBoard API limits.

        Current:
        ${totalCalls.round(2)} calls per 5 minutes

        Maximum:
        17 calls per 5 minutes
        """

        return false

    }


    state.apiWarning = null

    return true

}
/**************************************************************************************************
 *
 * Verify FireBoard Device Configuration
 *
 **************************************************************************************************/

def verifyFireBoardSettings() {

    def warnings = []


    def refreshSetting = fireboardDevice.getSetting("RefreshRate")

    def driveLogging = fireboardDevice.getSetting("HasDrive")
    
    String driveStatus = 
    (driveLogging == true || driveLogging == null) ? "Enabled" : "Disabled"
    
    if(refreshSetting != null && refreshSetting != "Manual") {

        warnings << 
        "FireBoard Refresh Rate is set to ${refreshSetting}. " +
        "Set it to Manual to prevent duplicate polling."

    }


    if(driveLogging == true || driveLogging == null) {

        warnings <<
        "FireBoard Drive Logging is enabled. " +
        "API calculations will include additional calls."

    }


    if(warnings) {

        warnings.each {
            log.warn "FireBoard Monitor: ${it}"
        }

        state.fireboardWarnings = warnings

        return false

    }


    state.fireboardWarnings = []

    return true

}

/**************************************************************************************************
 *
 * Stop Monitoring
 *
 **************************************************************************************************/

def stopMonitoring() {

    logInfo "Stopping FireBoard Monitor"

    unschedule("pollLoop")
	unschedule("startPolling")
    if(calculateFlipSwitch) {
        calculateFlipSwitch.off()
    }

    state.loopCounter = 0
    state.refreshCounter = 0
    state.grillStatus = []
	state.foodStatus = []

    logDebug "Polling stopped"

}

/**************************************************************************************************
 *
 * Validate Sensor Assignments and Sensor Selection
 *
 **************************************************************************************************/

def validateSensorAssignments() {

    logDebug "Running sensor assignment validation"

    if(!grillSensors && !foodSensors) {

        log.warn "No temperature sensors selected."
        return false

    }


    def grillIds = grillSensors.collect {
        it.id
    }


    def foodIds = foodSensors.collect {
        it.id
    }


    def overlap = grillIds.intersect(foodIds)


    if(overlap) {

        def names = []


        overlap.each { id ->

            def sensor = grillSensors.find {
                it.id == id
            }

            if(sensor) {

                names << sensor.label

            }

        }


        log.warn """
FireBoard Monitor:

The following sensors are assigned as both Grill and Food sensors:

${names.join(", ")}

Each sensor can only be assigned one role.
"""


        return false

    }


    return true

}

/**************************************************************************************************
 *
 * Temperature Monitoring
 *
 **************************************************************************************************/

def monitorTemperatures() {

    processGrillTemperatures()

    processFoodTemperatures()

}


def processGrillTemperatures() {

    logDebug "Grill State Count: ${state.grillStatus?.size()}"
    
    def updatedGrill = state.grillStatus.collect { grill ->

        def sensor = grillSensors.find {
            it.displayName == grill.sensor
        }

        if(sensor) {

            grill.currentTemp = sensor.currentTemperature


            /*
             * Refresh settings in case Hub Variables changed
           	 *
             * Target alert is a "grill ready" notification.
             * Reset only if user changes the cooking target.
             */

            def newTarget = getGrillTarget()
            def newLow    = getGrillLow()
            def newHigh   = getGrillHigh()


            if(grill.targetTemp != newTarget) {

                logDebug """
        Grill target changed:

        Old:
        ${grill.targetTemp}

        New:
        ${newTarget}

        Resetting target alert.
        """

                grill.targetAlertSent = false

            }


            grill.targetTemp = newTarget
            grill.lowAlert   = newLow
            grill.highAlert  = newHigh

        }

        if(grill.currentTemp >= grill.targetTemp) {

            grill.targetReached = true

            if(!grill.targetAlertSent) {

                grill.targetAlertSent = true

                def message = buildMessage(msgGrillTarget, [
                    sensor : grill.sensor,
                    current: grill.currentTemp,
                    target : grill.targetTemp
                ])

                sendAlert(message)

            }

        }

            if(grill.targetReached &&
               grill.currentTemp <= grill.lowAlert &&
               !grill.lowAlertSent) {

            grill.lowAlertSent = true

            def message = buildMessage(msgGrillLow, [
                sensor : grill.sensor,
                current: grill.currentTemp,
                target : grill.targetTemp,
                low    : grill.lowAlert
            ])

            sendAlert(message)

        }


        /*
         * Reset LOW alert once temperature recovers.
         *
         * This creates hysteresis:
         *
         * Alert:
         * Below low limit
         *
         * Reset:
         * Back above low limit
         */

        if(grill.currentTemp > grill.lowAlert) {

            if(grill.lowAlertSent) {

                logDebug "${grill.sensor} recovered above low temperature limit."

            }

            grill.lowAlertSent = false

        }

        if(grill.targetReached &&
           grill.currentTemp >= grill.highAlert &&
           !grill.highAlertSent) {

                grill.highAlertSent = true

                def message = buildMessage(msgGrillHigh, [
                    sensor : grill.sensor,
                    current: grill.currentTemp,
                    target : grill.targetTemp,
                    high   : grill.highAlert
                ])

            sendAlert(message)

        }


        /*
         * Reset HIGH alert once temperature drops.
         *
         * Alert:
         * Above high limit
         *
         * Reset:
         * Back below high limit
         */

        if(grill.currentTemp < grill.highAlert) {

            if(grill.highAlertSent) {

                logDebug "${grill.sensor} recovered below high temperature limit."

            }

            grill.highAlertSent = false

        }

        logDebug """
            Grill:
            Sensor: ${grill.sensor}
            Temp: ${grill.currentTemp}
            Target: ${grill.targetTemp}
            Low: ${grill.lowAlert}
            High: ${grill.highAlert}
            """

        return grill

    }

    state.grillStatus = updatedGrill
}

def processFoodTemperatures() {

    logDebug "Food State Count: ${state.foodStatus?.size()}"
    
    def updatedFood = state.foodStatus.collect { food ->

        def sensor = foodSensors.find {
            it.displayName == food.sensor
        }

        if(sensor) {

            food.currentTemp = sensor.currentTemperature
			if(useHubVariables && foodFlipVariable) {

                def hubFlip = getFoodFlip()

                if(hubFlip != null && hubFlip != food.flipTemp) {

                    logInfo """
            Food flip temperature changed from Hub Variable:

            Sensor:
            ${food.sensor}

            Old Flip:
            ${food.flipTemp}

            New Flip:
            ${hubFlip}
            """

                    food.flipTemp = hubFlip
                    food.lastCalculatedFlip = hubFlip
                    food.flipAlertSent = false

                }

            }

            /*
             * Refresh target temperature.
             *
             * If target changes before completion,
             * allow done alert again.
             */

            def newTarget = getFoodTarget()


            if(food.targetTemp != newTarget) {

                logDebug """
        Food target changed:

        Sensor:
        ${food.sensor}

        Old Target:
        ${food.targetTemp}

        New Target:
        ${newTarget}

        Resetting done alert.
        """

                food.doneAlertSent = false
                food.done = false

            }


            food.targetTemp = newTarget


            /*
             * Only update manual flip temperatures.
             *
             * Automatic flip temperatures remain
             * calculated from cook start.
             */

        }


        if(food.flipTemp &&
           food.currentTemp >= food.flipTemp &&
           !food.flipAlertSent) {


            food.flipAlertSent = true

            def message = buildMessage(msgFoodFlip, [
                sensor : food.sensor,
                current: food.currentTemp,
                flip   : food.flipTemp,
                target : food.targetTemp
            ])

            sendAlert(message)

        }


        if(food.currentTemp >= food.targetTemp &&
           !food.doneAlertSent) {


            food.doneAlertSent = true
            food.done = true

            def message = buildMessage(msgFoodDone, [
                sensor : food.sensor,
                current: food.currentTemp,
                target : food.targetTemp
            ])

            sendAlert(message)

        }


         logDebug """
            Food:
            Sensor: ${food.sensor}
            Temp: ${food.currentTemp}
            Target: ${food.targetTemp}
            Flip: ${food.flipTemp}
            Done: ${food.done}
            """

        return food

    }

    state.foodStatus = updatedFood

}

/**************************************************************************************************
 *
 * Temperature Setting Helpers
 *
 **************************************************************************************************/

def getGrillTarget() {

    if(useHubVariables) {

        return getHubVariableValue(grillTargetVariable)

    }

    return grillTargetTemp as BigDecimal

}


def getGrillLow() {


    if(useHubVariables && grillLowOffsetVariable) {


        def offset = getHubVariableValue(grillLowOffsetVariable)


        return getGrillTarget() - offset


    }


    return getGrillTarget() - (grillLowOffset ?: 0)

}


def getGrillHigh() {


    if(useHubVariables && grillHighOffsetVariable) {


        def offset = getHubVariableValue(grillHighOffsetVariable)


        return getGrillTarget() + offset


    }


    return getGrillTarget() + (grillHighOffset ?: 0)

}


def getFoodTarget() {


    if(useHubVariables) {


        return getHubVariableValue(foodTargetVariable)


    }


    return foodTargetTemp as BigDecimal

}

def getFoodFlip() {


    if(useHubVariables && foodFlipVariable) {


        return getHubVariableValue(foodFlipVariable)


    }


    return foodFlipTemp ? foodFlipTemp as BigDecimal : null

}

/**************************************************************************************************
 *
 * Hub Variable Helpers
 *
 **************************************************************************************************/

def getHubNumberVariables() {

    def options = [:]

    def variables = getGlobalVarsByType("integer")
    variables.putAll(getGlobalVarsByType("bigdecimal"))

    variables.each { name, variable ->

        options[name] = name

    }

    return options

}

def getHubVariableValue(variableName) {

    if(!variableName) {
        return null
    }

    def variable = getGlobalVar(variableName)

    if(variable == null) {

        log.warn "FireBoard Monitor: Global Variable '${variableName}' not found"

        return null

    }

    try {
    return variable.value as BigDecimal
        }
        catch(Exception e) {
            log.warn "Global Variable '${variableName}' is not numeric"
            return null
        }

}

def validateHubVariables() {

    if(!useHubVariables) {
        return true
    }

    def requiredVariables = []


    if(grillTargetVariable) {
        requiredVariables << grillTargetVariable
    }


    if(foodTargetVariable) {
        requiredVariables << foodTargetVariable
    }


    if(grillLowOffsetVariable) {
        requiredVariables << grillLowOffsetVariable
    }


    if(grillHighOffsetVariable) {
        requiredVariables << grillHighOffsetVariable
    }


    if(foodFlipVariable) {
        requiredVariables << foodFlipVariable
    }


    def missing = requiredVariables.findAll {
        getGlobalVar(it) == null
    }


    if(missing) {

        log.error """
FireBoard Monitor:

The following Hub Variables no longer exist:

${missing.join("\n")}

Please update the FireBoard Monitor settings.
"""

        return false
    }


    return true
}

def setHubVariableValue(variableName, value) {

    if(!variableName || value == null) {
        return
    }

    def variable = getGlobalVar(variableName)

    if(variable) {

        setGlobalVar(
            variableName,
            value.toInteger().toString()
        )

        logDebug "Updated Hub Variable ${variableName} = ${value.toInteger()}"

    }
    else {

        logWarn "Hub Variable '${variableName}' not found"

    }

}

void renameVariable(String oldName, String newName) {

    settings.findAll { k, v -> v == oldName }.each { k, v ->
        app.updateSetting(k, [type: "enum", value: newName])
    }

}

/**************************************************************************************************
 *
 * Alert Handling
 *
 **************************************************************************************************/

def sendAlert(message) {

    if(!enableNotifications) {

        logDebug "Notifications disabled: ${message}"

        return

    }


    logInfo "Alert: ${message}"


    /*
     * Phone notifications
     */

    if(notificationDevices) {

        notificationDevices.each { device ->

            try {

                device.deviceNotification(message)

            }
            catch(Exception e) {

                log.warn "Notification failed for ${device.displayName}: ${e}"

            }

        }

    }


    /*
     * TTS notifications
     */

    if(speechDevices) {

        speechDevices.each { speaker ->

            try {

                speaker.speak(message)

            }
            catch(Exception e) {

                log.warn "TTS failed for ${speaker.displayName}: ${e}"

            }

        }

    }

}

/**************************************************************************************************
 *
 * Message Helpers
 *
 **************************************************************************************************/

def buildMessage(template, values = [:]) {

    def msg = template ?: ""

    values.each { key, value ->
        msg = msg.replace("%${key}%", value?.toString() ?: "")
    }

    return msg

}

