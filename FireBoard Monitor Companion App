 *
 * Logging Helpers
 *
 **************************************************************************************************/

def logInfo(msg) {

    log.info "FireBoard Monitor: ${msg}"

}


def logDebug(msg) {

    if(enableDebug) {

        log.debug "FireBoard Monitor: ${msg}"

    }
}

def logWarn(msg) {

    log.warn "FireBoard Monitor: ${msg}"

}
