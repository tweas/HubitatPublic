/**************************************************************************************************
 *
 *  Installed
 *
 **************************************************************************************************/

def installed() {

    log.info "FireBoard Monitor Installed"

    initialize()

}

/**************************************************************************************************
 *
 *  Updated
 *
 **************************************************************************************************/

def updated() {

    log.info "FireBoard Monitor Updated"

    unsubscribe()
    unschedule()

    removeAllInUseGlobalVar()

    def vars = []

    if (useHubVariables) {
        if (grillTargetVariable)     vars << grillTargetVariable
        if (grillLowOffsetVariable)  vars << grillLowOffsetVariable
        if (grillHighOffsetVariable) vars << grillHighOffsetVariable
        if (foodTargetVariable)      vars << foodTargetVariable
        if (foodFlipVariable)        vars << foodFlipVariable

        if(vars) {
            addInUseGlobalVar(vars)
        }
    }

    initialize()
}

/**************************************************************************************************
 *
 *  Initialize
 *
 **************************************************************************************************/

def initialize() {

    log.info "Initializing FireBoard Monitor"

    subscribe(triggerSwitch,
              "switch",
              triggerHandler)
    
     if(calculateFlipSwitch) {

        logDebug "Subscribing to Calculate Flip Switch: ${calculateFlipSwitch.displayName}"

        subscribe(
            calculateFlipSwitch,
            "switch.on",
            calculateFlipHandler
        )

    }
    else {

        logDebug "No Calculate Flip Switch selected"

    }

}
